# Luneto API 服务环境变量示例
# 复制为 .env 后按本地环境修改:
#   cp .env.example .env
#
# 本地 MySQL / Redis 可通过 Docker 启动（与 langfuse-local 独立）:
#   pnpm docker:up

# 服务端口
PORT=3100

# JWT（登录签发 access token；生产环境务必更换）
JWT_SECRET=luneto-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# MySQL（docker-compose 会读取 MYSQL_PASSWORD / MYSQL_DATABASE / MYSQL_PORT）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=luneto

# Redis（docker-compose 会读取 REDIS_PORT / REDIS_PASSWORD）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
