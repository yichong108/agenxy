{
  "name": "agenwork",
  "version": "1.0.0-alpha.1",
  "description": "Agenwork — AI Agent 套件 (桌面应用 + 落地页 + 本地服务)",
  "keywords": [
    "agenwork",
    "ai",
    "agent",
    "desktop",
    "landing",
    "langfuse"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agenwork/agenwork.git"
  },
  "author": "Wang Zhang",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev:prepare": "pnpm --filter @agenwork/api docker:up",
    "dev": "pnpm run dev:prepare && turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "format:desktop": "pnpm --filter @agenwork/desktop run format",
    "format:check:desktop": "pnpm --filter @agenwork/desktop run format:check",
    "format:landing": "pnpm --filter @agenwork/landing run format",
    "format:check:landing": "pnpm --filter @agenwork/landing run format:check",
    "desktop:dev": "pnpm --filter @agenwork/desktop dev",
    "desktop:build": "pnpm --filter @agenwork/desktop build",
    "desktop:build:app": "pnpm --filter @agenwork/desktop build:app",
    "desktop:preview": "pnpm --filter @agenwork/desktop preview",
    "landing:dev": "pnpm --filter @agenwork/landing dev",
    "landing:build": "pnpm --filter @agenwork/landing build",
    "langfuse:start": "pnpm --filter @agenwork/langfuse-local run start",
    "langfuse:stop": "pnpm --filter @agenwork/langfuse-local run stop",
    "langfuse:status": "pnpm --filter @agenwork/langfuse-local run status",
    "langfuse:logs": "pnpm --filter @agenwork/langfuse-local run logs",
    "langfuse:reset": "pnpm --filter @agenwork/langfuse-local run reset",
    "api:dev": "pnpm --filter @agenwork/api dev",
    "api:build": "pnpm --filter @agenwork/api build",
    "api:start": "pnpm --filter @agenwork/api start",
    "api:typecheck": "pnpm --filter @agenwork/api typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
