{
  "name": "openwork",
  "version": "1.0.0-alpha.1",
  "description": "Openwork — AI Agent 套件 (桌面应用 + 命令行 + 落地页 + 本地服务)",
  "keywords": [
    "openwork",
    "ai",
    "agent",
    "desktop",
    "cli",
    "landing",
    "langfuse"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yichong108/openwork.git"
  },
  "author": "Wang Zhang",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev:prepare": "pnpm --filter @openwork/api docker:up",
    "dev": "pnpm run dev:prepare && turbo run dev --parallel",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,cjs,js,jsx,json,md,scss,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,cjs,js,jsx,json,md,scss,css}\"",
    "desktop:dev": "pnpm --filter @openwork/desktop dev",
    "desktop:build": "pnpm --filter @openwork/desktop build",
    "desktop:build:app": "pnpm --filter @openwork/desktop build:app",
    "desktop:preview": "pnpm --filter @openwork/desktop preview",
    "landing:dev": "pnpm --filter @openwork/landing dev",
    "landing:build": "pnpm --filter @openwork/landing build",
    "admin:dev": "pnpm --filter @openwork/admin dev",
    "admin:build": "pnpm --filter @openwork/admin build",
    "admin:typecheck": "pnpm --filter @openwork/admin typecheck",
    "langfuse:start": "pnpm --filter @openwork/langfuse-local run start",
    "langfuse:stop": "pnpm --filter @openwork/langfuse-local run stop",
    "langfuse:status": "pnpm --filter @openwork/langfuse-local run status",
    "langfuse:logs": "pnpm --filter @openwork/langfuse-local run logs",
    "langfuse:reset": "pnpm --filter @openwork/langfuse-local run reset",
    "api:dev": "pnpm --filter @openwork/api dev",
    "api:build": "pnpm --filter @openwork/api build",
    "api:start": "pnpm --filter @openwork/api start",
    "api:typecheck": "pnpm --filter @openwork/api typecheck",
    "cli:dev": "pnpm --filter @openwork/cli dev",
    "cli:start": "pnpm --filter @openwork/cli start",
    "cli:build": "pnpm --filter @openwork/cli build",
    "cli:start:dist": "pnpm --filter @openwork/cli start:dist",
    "cli:typecheck": "pnpm --filter @openwork/cli typecheck",
    "phone:dev": "pnpm --filter @openwork/phone dev",
    "phone:start": "pnpm --filter @openwork/phone start",
    "phone:android": "pnpm --filter @openwork/phone android",
    "phone:ios": "pnpm --filter @openwork/phone ios",
    "phone:web": "pnpm --filter @openwork/phone web",
    "phone:typecheck": "pnpm --filter @openwork/phone typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxlint": "^1.77.0",
    "prettier": "^3.8.3",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
