{
  "name": "luneto",
  "version": "1.0.0-alpha.1",
  "description": "Luneto — AI Agent 套件 (桌面应用 + 命令行 + 落地页 + 本地服务)",
  "keywords": [
    "luneto",
    "ai",
    "agent",
    "desktop",
    "command",
    "cli",
    "landing",
    "langfuse"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/luneto/luneto.git"
  },
  "author": "Wang Zhang",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev:prepare": "pnpm --filter @luneto/api docker:up",
    "dev": "pnpm run dev:prepare && turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "format:desktop": "pnpm --filter @luneto/desktop run format",
    "format:check:desktop": "pnpm --filter @luneto/desktop run format:check",
    "format:landing": "pnpm --filter @luneto/landing run format",
    "format:check:landing": "pnpm --filter @luneto/landing run format:check",
    "desktop:dev": "pnpm --filter @luneto/desktop dev",
    "desktop:build": "pnpm --filter @luneto/desktop build",
    "desktop:build:app": "pnpm --filter @luneto/desktop build:app",
    "desktop:preview": "pnpm --filter @luneto/desktop preview",
    "landing:dev": "pnpm --filter @luneto/landing dev",
    "landing:build": "pnpm --filter @luneto/landing build",
    "admin:dev": "pnpm --filter @luneto/admin dev",
    "admin:build": "pnpm --filter @luneto/admin build",
    "admin:typecheck": "pnpm --filter @luneto/admin typecheck",
    "langfuse:start": "pnpm --filter @luneto/langfuse-local run start",
    "langfuse:stop": "pnpm --filter @luneto/langfuse-local run stop",
    "langfuse:status": "pnpm --filter @luneto/langfuse-local run status",
    "langfuse:logs": "pnpm --filter @luneto/langfuse-local run logs",
    "langfuse:reset": "pnpm --filter @luneto/langfuse-local run reset",
    "api:dev": "pnpm --filter @luneto/api dev",
    "api:build": "pnpm --filter @luneto/api build",
    "api:start": "pnpm --filter @luneto/api start",
    "api:typecheck": "pnpm --filter @luneto/api typecheck",
    "command:dev": "pnpm --filter @luneto/command dev",
    "command:start": "pnpm --filter @luneto/command start",
    "command:build": "pnpm --filter @luneto/command build",
    "command:start:dist": "pnpm --filter @luneto/command start:dist",
    "command:typecheck": "pnpm --filter @luneto/command typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
